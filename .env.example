# Settings that must not live in the code. Copy this file to ".env" (which git ignores) and fill it in.
# On Railway, put the same names in the service's Variables tab instead.

# "Turn your notes into flashcards" uses Claude. Get a key at https://console.anthropic.com (it is pay-per-use).
# Leave it empty to use the built-in demo, which is clearly labelled and not real AI.
ANTHROPIC_API_KEY=

# Who may use the feature, because every use costs money. Comma-separated emails.
# On the live site nobody can use it unless they are listed here. (On your own computer everyone can.)
NOTES_AI_USERS=

# Optional. The default is claude-opus-5-5 (best quality). claude-sonnet-5-5 costs about half as much.
# NOTES_AI_MODEL=claude-opus-5-5

# Optional. How many times each person can use it per day (default 20).
# NOTES_AI_DAILY_LIMIT=20

# Who can open the owner dashboard (/admin): comma-separated login emails. Only list an email that already has an account.
# ADMIN_EMAILS=you@example.com

# Optional, set before building: shown on the Cookies & privacy page for deletion requests.
# VITE_CONTACT_EMAIL=you@example.com
